      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:13. Seeing peers or classmates secure jobs or internships makes me feel...!:nk]' palette='sf_watermelon' type='palette'>
            <map to='#c11c2f'>
              <bucket>&quot;Stressed about my own progress&quot;</bucket>
            </map>
            <map to='#f4284e'>
              <bucket>&quot;Indifferent&quot;</bucket>
            </map>
            <map to='#f56580'>
              <bucket>&quot;Happy and motivated for them&quot;</bucket>
            </map>
            <map to='#f598a7'>
              <bucket>&quot;Anxious and left behind&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Gender:nk]' type='palette'>
            <map to='#76b7b2'>
              <bucket>&quot;Female&quot;</bucket>
            </map>
            <map to='#9c755f'>
              <bucket>&quot;Prefer not to say&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Male&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Number of Internships completed?:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;3+&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;0&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;1&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;2&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:How would you describe your current readiness for the job market?:nk]' palette='cyclic_10_0' type='palette'>
            <map to='#1ba3c6'>
              <bucket>&quot;Not prepared at all&quot;</bucket>
            </map>
            <map to='#4f7cba'>
              <bucket>&quot;Very prepared (Resume ready, networking, active applications)&quot;</bucket>
            </map>
            <map to='#bcbd22'>
              <bucket>&quot;Not very prepared (Unsure where to look or how to start)&quot;</bucket>
            </map>
            <map to='#f43c63'>
              <bucket>&quot;Somewhat prepared (Have a basic resume, looking at options)&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:11. When you think about the job search process, which emotion is most dominant?:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;Indifference&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Motivation / Excitement&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Hopelessness / Pessimism&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;Confusion / Feeling overwhelmed&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Fear of rejection / Failure&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:14. How much does pressure from your family or community contribute to your employment anxiety?:nk]' palette='sf_watermelon' type='palette'>
            <map to='#c11c2f'>
              <bucket>&quot;No contribution at all&quot;</bucket>
            </map>
            <map to='#f4284e'>
              <bucket>&quot;Moderate contribution&quot;</bucket>
            </map>
            <map to='#f56580'>
              <bucket>&quot;Minimal contribution&quot;</bucket>
            </map>
            <map to='#f598a7'>
              <bucket>&quot;Major contribution&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:15. Do you ever feel that your chosen field of study might not yield sustainable job opportunities?:nk]' palette='sf_light' type='palette'>
            <map to='#3296ed'>
              <bucket>&quot;Never thought about it&quot;</bucket>
            </map>
            <map to='#77b9f2'>
              <bucket>&quot;Rarely, I feel confident in my major&quot;</bucket>
            </map>
            <map to='#9d53f2'>
              <bucket>&quot;Sometimes, but I am trying to stay optimistic&quot;</bucket>
            </map>
            <map to='#c398f5'>
              <bucket>&quot;Yes, I regret my choice often&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:19. If you do not secure a job immediately after graduation, what is your backup plan?:nk]' palette='blue_10_0' type='palette'>
            <map to='#2a5783'>
              <bucket>&quot;Taking any available lower-tier job or internship&quot;</bucket>
            </map>
            <map to='#4776a4'>
              <bucket>&quot;Taking a gap year to figure things out&quot;</bucket>
            </map>
            <map to='#6798c1'>
              <bucket>&quot;Pursuing further education / Higher studies&quot;</bucket>
            </map>
            <map to='#8bbadc'>
              <bucket>&quot;I do not have a backup plan&quot;</bucket>
            </map>
            <map to='#b9ddf1'>
              <bucket>&quot;Freelancing or starting a small business&quot;</bucket>
